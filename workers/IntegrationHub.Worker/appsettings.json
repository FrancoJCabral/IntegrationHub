{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Exchange": "integrationhub.jobs",
    "Queue": "integrationhub.worker",
    "RoutingKey": "integration.job.submitted"
  },
  "Worker": {
    "Enabled": false
  },
  "Resilience": {
    "BaseDelayMilliseconds": 200,
    "TimeoutSeconds": 5,
    "MaxRetryAttempts": 3,
    "CircuitBreaker": {
      "SamplingDurationSeconds": 30,
      "MinimumThroughput": 4,
      "FailureRatio": 0.5,
      "BreakDurationSeconds": 15
    }
  },
  "Idempotency": {
    "RetentionHours": 24,
    "Provider": "InMemory",
    "LeaseSeconds": 120
  },
  "Redis": {
    "Configuration": "localhost:6379"
  }
}
