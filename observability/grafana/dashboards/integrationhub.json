      "id": 1,
      "type": "stat",
      "title": "Jobs publicados",
      "description": "Total acumulado desde el inicio del proceso. Se reinicia al reiniciar el servicio.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(integrationhub_jobs_published_total) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
